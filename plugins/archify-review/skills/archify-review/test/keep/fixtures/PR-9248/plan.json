      "from_symbol": "PlatformNavigationDelegate.setOnSSlAuthError",
      "to_symbol": "PlatformSslAuthError",
      "story": "**navigation delegate** 像大樓的保全，遇到證件有問題的訪客（SSL 錯誤）就把訪客資料 `PlatformSslAuthError` 交給住戶的對講機 `SslAuthErrorCallback`，由住戶決定開門（`proceed`）或請回（`cancel`）。",
      "note": "新增 SSL 錯誤 callback 的型別與設定方法。",
      "tests": {
        "functions": [
          {
            "symbol": "setOnSSlAuthError",
            "why": "平台沒實作時要丟 `UnimplementedError`，App 才知道這個平台不支援 SSL 錯誤處理",
            "lines": "+155..+164",
            "status": "new",
            "by": [
              "Default implementation of setOnSSlAuthError should throw unimplemented error"
            ]
          }
        ],
        "cases": [
          {
            "test": "Default implementation of setOnSSlAuthError should throw unimplemented error",
            "covers": [
              "setOnSSlAuthError"
            ],
            "given": "沒有覆寫的 `ExtendsPlatformNavigationDelegate`",
            "when": "呼叫 `setOnSSlAuthError` 並傳入空 callback",
            "then": "丟出 `UnimplementedError`"
          }
        ]
      }
    },
